{
  "schemaVersion": "1.0",
  "repository": "jussray/chief-ai-machine",
  "portfolioHub": "jussray/founder-control-room",
  "role": "product-workbench",
  "authority": {
    "sourceOfTruth": "Current main, exact-head Quality Gate, repository contracts, exact-head test ledger, and Chromium persistence proof",
    "portfolioMode": "sanitized-read-only-observer",
    "productionMutation": "separate-founder-gate"
  },
  "controlRoom": {
    "localSurface": true,
    "surfaces": [
      "control-room.manifest.json",
      ".control-room/repository.manifest.json",
      ".control-room/test-ledger.manifest.json",
      ".github/workflows/quality-gate.yml",
      ".github/workflows/freestyle-save-playwright.yml",
      ".github/workflows/control-room-contracts.yml",
      ".github/workflows/control-room-test-ledger.yml"
    ],
    "privateContentAllowed": false
  },
  "tests": {
    "authority": "repo-native",
    "aggregation": "sanitized-check-summary-to-founder-control-room",
    "rawLogsAllowed": false,
    "catalog": [
      {
        "id": "typecheck",
        "name": "Chief AI TypeScript",
        "kind": "typecheck",
        "command": "npm run typecheck",
        "required": true,
        "status": "active",
        "evidencePaths": ["package.json", ".github/workflows/quality-gate.yml"]
      },
      {
        "id": "lint",
        "name": "Chief AI lint",
        "kind": "lint",
        "command": "npm run lint",
        "required": true,
        "status": "active",
        "evidencePaths": ["package.json", ".github/workflows/quality-gate.yml"]
      },
      {
        "id": "unit-tests",
        "name": "Chief AI unit tests",
        "kind": "unit",
        "command": "npm test",
        "required": true,
        "status": "active",
        "evidencePaths": ["package.json", ".github/workflows/quality-gate.yml"]
      },
      {
        "id": "mcp-contract",
        "name": "Chief AI MCP contract",
        "kind": "contract",
        "command": "npm run verify:mcp",
        "required": true,
        "status": "active",
        "evidencePaths": ["package.json", "scripts/verify-mcp-config.mjs", ".github/workflows/control-room-contracts.yml"]
      },
      {
        "id": "cookie-contract",
        "name": "Chief AI cookie contract",
        "kind": "security",
        "command": "npm run verify:cookies",
        "required": true,
        "status": "active",
        "evidencePaths": ["package.json", "scripts/verify-cookie-contract.mjs", ".github/workflows/control-room-contracts.yml"]
      },
      {
        "id": "founder-chief-pair",
        "name": "Founder–Chief pairing contract",
        "kind": "contract",
        "command": "npm run verify:founder-chief-pair",
        "required": true,
        "status": "active",
        "evidencePaths": ["package.json", "scripts/verify-founder-chief-pair.mjs", ".github/workflows/control-room-contracts.yml"]
      },
      {
        "id": "control-room-test-ledger-contract",
        "name": "Control Room test-ledger policy contract",
        "kind": "contract",
        "command": "npx vitest run test/control-room-test-ledger.test.mjs",
        "required": true,
        "status": "active",
        "evidencePaths": [
          ".control-room/test-ledger.manifest.json",
          "scripts/control-room-test-ledger.mjs",
          "test/control-room-test-ledger.test.mjs",
          ".github/workflows/control-room-test-ledger.yml"
        ]
      },
      {
        "id": "control-room-test-ledger-publish",
        "name": "Control Room exact-head ledger observer",
        "kind": "contract",
        "command": "node scripts/control-room-test-ledger.mjs",
        "required": true,
        "status": "active",
        "evidencePaths": [
          ".control-room/test-ledger.manifest.json",
          "scripts/control-room-test-ledger.mjs",
          ".github/workflows/control-room-test-ledger.yml"
        ]
      },
      {
        "id": "freestyle-save-playwright",
        "name": "Freestyle save and persistence Chromium proof",
        "kind": "e2e",
        "command": "npx playwright test --config=e2e/playwright.freestyle.config.mjs",
        "required": true,
        "status": "active",
        "evidencePaths": [
          "e2e/freestyle-save.pw.mjs",
          "e2e/playwright.freestyle.config.mjs",
          ".github/workflows/freestyle-save-playwright.yml"
        ]
      }
    ]
  },
  "evidence": {
    "status": "verified",
    "commit": "303954c3c8b7ca737f3409af6e4d88927d8492d4",
    "observedAt": "2026-08-04",
    "proofRefs": [
      ".github/workflows/quality-gate.yml",
      ".github/workflows/control-room-contracts.yml",
      ".github/workflows/control-room-test-ledger.yml",
      ".control-room/test-ledger.manifest.json",
      "scripts/control-room-test-ledger.mjs",
      "test/control-room-test-ledger.test.mjs",
      ".github/workflows/freestyle-save-playwright.yml",
      "e2e/freestyle-save.pw.mjs",
      "package.json"
    ]
  },
  "risk": {
    "level": "medium",
    "blockers": [
      "Cloudflare production deployment remains a separate provider gate",
      "A catalog entry is not a pass until its exact-head provider signal succeeds",
      "Prompt inputs, saved drafts, and copied output must never enter portfolio packets"
    ]
  },
  "nextGate": "Keep the local and canonical Control Room catalogs in parity and require exact-head provider signals before any portfolio claim."
}
