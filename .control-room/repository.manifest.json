{
  "schemaVersion": "1.0",
  "projectId": "chief-ai-machine",
  "repository": {
    "provider": "github",
    "identifier": "jussray/chief-ai-machine",
    "defaultBranch": "main"
  },
  "verification": {
    "requiredSignals": [
      {
        "id": "typecheck",
        "name": "Typecheck",
        "required": true
      },
      {
        "id": "lint",
        "name": "Lint",
        "required": true
      },
      {
        "id": "unit-tests",
        "name": "Unit Tests",
        "required": true
      }
    ]
  },
  "capabilities": [
    {
      "id": "prompt-library-prototype",
      "description": "Serves the browser prompt library and benchmark data from versioned repository files.",
      "status": "active",
      "evidencePaths": [
        "src/main.js",
        "src/data/prompts.js",
        "src/data/benchmarks.js",
        "src/modules/library.js",
        "index.html"
      ],
      "requiredSignals": [
        "typecheck",
        "lint",
        "unit-tests"
      ],
      "usageAssertions": [
        {
          "id": "entrypoint-imports-prompts",
          "path": "src/main.js",
          "marker": "./data/prompts.js",
          "description": "The browser entrypoint imports the versioned prompt library."
        },
        {
          "id": "entrypoint-initializes-library",
          "path": "src/main.js",
          "marker": "initLibrary(PROMPTS, modal)",
          "description": "The prompt library module is initialized after DOM readiness."
        },
        {
          "id": "entrypoint-renders-benchmarks",
          "path": "src/main.js",
          "marker": "BENCHMARKS.forEach",
          "description": "Versioned benchmark rows are rendered into the current prototype."
        }
      ]
    },
    {
      "id": "prompt-builder-prototype",
      "description": "Builds repository- and platform-specific prompts in the current client-side prototype.",
      "status": "active",
      "evidencePaths": [
        "src/main.js",
        "src/modules/builder.js",
        "src/modules/freestyle.js",
        "src/modules/custom.js"
      ],
      "requiredSignals": [
        "typecheck",
        "lint"
      ],
      "usageAssertions": [
        {
          "id": "entrypoint-initializes-builder",
          "path": "src/main.js",
          "marker": "initBuilder(PROMPTS)",
          "description": "The browser entrypoint initializes the structured prompt builder."
        },
        {
          "id": "entrypoint-initializes-freestyle",
          "path": "src/main.js",
          "marker": "initFreestyle(PROMPTS)",
          "description": "The freestyle builder is part of the active page lifecycle."
        },
        {
          "id": "entrypoint-initializes-custom-prompts",
          "path": "src/main.js",
          "marker": "initCustom(PROMPTS, modal)",
          "description": "Custom prompt state is wired into the browser prototype."
        }
      ]
    },
    {
      "id": "provider-neutral-operating-contracts",
      "description": "Documents portable provider roles and founder operating modes without making one AI vendor authoritative.",
      "status": "active",
      "evidencePaths": [
        "README.md",
        "CLAUDE.md",
        "AGENTS.md",
        "docs/OPERATING_MODES.md",
        "docs/PLATFORM_ROUTING.md"
      ],
      "requiredSignals": [
        "lint"
      ],
      "usageAssertions": [
        {
          "id": "readme-links-global-agent-contracts",
          "path": "README.md",
          "marker": "docs/OPERATING_MODES.md",
          "description": "The repository entry documentation routes builders to the portable operating contracts."
        },
        {
          "id": "readme-states-provider-portability",
          "path": "README.md",
          "marker": "Use them. Do not depend on them.",
          "description": "The visible project directive explicitly rejects provider lock-in."
        }
      ]
    },
    {
      "id": "private-server-prompt-operations",
      "description": "Private access control, durable server-side prompt storage, and real model execution.",
      "status": "planned",
      "evidencePaths": [],
      "requiredSignals": [],
      "usageAssertions": []
    }
  ],
  "buildAssist": {
    "enabled": true,
    "preferredBuilder": "codex",
    "riskLevel": "medium"
  },
  "privacy": {
    "allowlistedPacketFields": [
      "projectId",
      "repository.provider",
      "repository.identifier",
      "commitSha",
      "branch",
      "manifestHash",
      "generatedAt",
      "runner.provider",
      "runner.runId",
      "runner.detailsUrl",
      "checks.id",
      "checks.name",
      "checks.required",
      "checks.status",
      "checks.detailsUrl",
      "capabilities.id",
      "capabilities.claimedStatus",
      "capabilities.observedStatus",
      "capabilities.evidencePaths",
      "capabilities.usageAssertionIds",
      "capabilities.failedUsageAssertionIds",
      "capabilities.reason"
    ],
    "forbiddenData": [
      "private prompt contents not already versioned in the repository",
      "usage assertion marker text in runner packets",
      "provider API keys",
      "founder account credentials",
      "customer or user data",
      "raw model conversations",
      "unredacted runner logs"
    ]
  }
}
