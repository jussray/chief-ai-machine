{
  "mcpServers": {
    "founder-control-room": {
      "type": "http",
      "url": "https://api.foundercontrolroom.org/mcp"
    },
    "github": {
      "type": "http",
      "url": "https://api.githubcopilot.com/mcp/",
      "headers": {
        "X-MCP-Toolsets": "repos,issues,pull_requests,actions,code_security,secret_protection",
        "X-MCP-Lockdown": "true"
      }
    },
    "supabase": {
      "type": "http",
      "url": "https://mcp.supabase.com/mcp?project_ref=lghpwoktsytutssjiwgy&read_only=true&features=database,docs"
    },
    "context7": {
      "type": "http",
      "url": "https://mcp.context7.com/mcp"
    },
    "playwright": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@0.0.78",
        "--isolated",
        "--browser",
        "chromium"
      ]
    }
  }
}
