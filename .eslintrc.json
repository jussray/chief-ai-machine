{
  "env": {
    "node": true,
    "es2021": true,
    "browser": true
  },
  "globals": {
    "process": "readonly",
    "URL": "readonly",
    "Request": "readonly",
    "Response": "readonly",
    "fetch": "readonly",
    "console": "readonly",
    "TextEncoder": "readonly",
    "TextDecoder": "readonly",
    "crypto": "readonly",
    "Buffer": "readonly",
    "Uint8Array": "readonly",
    "window": "readonly",
    "ReadableStream": "readonly",
    "Headers": "readonly"
  },
  "parserOptions": {
    "ecmaVersion": 2021,
    "sourceType": "module"
  },
  "rules": {
    "no-undef": "error",
    "no-unused-vars": ["error", { "argsIgnorePattern": "^_", "varsIgnorePattern": "^_" }],
    "no-useless-assignment": "warn",
    "no-control-regex": "warn"
  }
}
