{
  // DOM modules remain lightweight prototype glue. Typechecking is focused on
  // portable domain contracts, static data, and the Worker where malformed state
  // or provider drift would create durable product errors.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "skipLibCheck": true,
    "strict": false
  },
  "include": ["src/data/**/*.js", "src/domain/**/*.js", "worker/**/*.js"]
}
