{
  "name": "chief-ai",
  "compatibility_date": "2026-07-11",
  "main": "security/chief-edge-entry.js",
  "vars": {
    "CHIEF_MUSE_MODEL": "muse-spark-1.3"
  },
  "build": {
    "command": "node scripts/bake-worker-release-sha.mjs"
  },
  "ratelimits": {
    "CHIEF_RATE_LIMITER": {
      "simple": {
        "limit": 120,
        "period": 60
      }
    }
  },
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api", "/api/*", "/github", "/github/*", "/version", "/mcp", "/.well-known/security.txt", "/auth.md"]
  }
}
