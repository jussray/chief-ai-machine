{
  "name": "chief-ai",
  "compatibility_date": "2026-07-11",
  "main": "worker/index.js",
  "build": {
    "command": "node scripts/bake-worker-release-sha.mjs"
  },
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "vars": {
    "FCR_RELAY_SUPABASE_URL": "https://oojzfmmywbvficgybaxd.supabase.co",
    "CHIEF_FEDERATED_RELAY_KEY_ID": "chief-ai-machine:relay-v3:2026-09",
    "CHIEF_FEDERATED_RELAY_KEY_VALID_FROM": "2026-09-13T00:00:00.000Z"
  },
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/version", "/mcp"]
  }
}
