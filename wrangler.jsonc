{
  "name": "chief-ai",
  "compatibility_date": "2026-07-11",
  "main": "security/chief-edge-entry.js",
  "workers_dev": true,
  "routes": [
    { "pattern": "chief.foundercontrolroom.org", "custom_domain": true },
    { "pattern": "app.chief.foundercontrolroom.org", "custom_domain": true },
    { "pattern": "api.chief.foundercontrolroom.org", "custom_domain": true }
  ],
  "build": {
    "command": "node scripts/bake-worker-release-sha.mjs"
  },
  "ratelimits": [
    {
      "name": "CHIEF_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": {
        "limit": 120,
        "period": 60
      }
    }
  ],
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api", "/api/*", "/github", "/github/*", "/version", "/mcp", "/.well-known/security.txt"]
  }
}
