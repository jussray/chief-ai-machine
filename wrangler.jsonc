{
  "name": "chief-ai",
  "compatibility_date": "2026-07-11",
  "compatibility_flags": ["nodejs_compat"],
  "main": "worker/index.js",
  "preview_urls": true,
  "build": {
    "command": "node scripts/bake-worker-release-sha.mjs"
  },
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/version", "/mcp"]
  }
}
