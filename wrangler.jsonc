{
  "name": "chief-ai",
  "compatibility_date": "2026-07-11",
  "main": "security/chief-edge-entry.js",
  "build": {
    "command": "node scripts/bake-worker-release-sha.mjs"
  },
  "ratelimits": [
    {
      "name": "CHIEF_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": {
        "limit": 120,
        "period": 60
      }
    }
  ],
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/github/*", "/version", "/mcp"]
  }
}
