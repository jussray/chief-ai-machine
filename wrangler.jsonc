{
  "name": "chief-ai",
  "compatibility_date": "2026-07-11",
  "compatibility_flags": ["nodejs_compat"],
  "main": "worker/index.js",
  "build": {
    "command": "node scripts/bake-worker-release-sha.mjs"
  },
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/version", "/mcp", "/.well-known/*", "/auth.md", "/agents/*", "/webhook/*"]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "GoalFixAgent",
        "class_name": "GoalFixAgent",
        "script_name": "chief-ai"
      },
      {
        "name": "ReviewMergeAgent",
        "class_name": "ReviewMergeAgent",
        "script_name": "chief-ai"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["GoalFixAgent", "ReviewMergeAgent"]
    }
  ],
  "ai": {
    "binding": "AI"
  }
}
